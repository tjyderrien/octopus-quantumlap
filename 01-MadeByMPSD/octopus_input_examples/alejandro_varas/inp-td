MoveIons = yes

XCFunctional = gga_x_pbe_r + gga_c_pbe
XCKernel = xc_functional

TypeOfMixing = broyden
Mixing = 0.02

LCAOStart = lcao_states

EigenSolver = rmmdiis

###############
# Laser field
###############

T  = 3307.2*2.0 # ~160 fs
dt = 0.06       
TDPropagator = aetrs
TDMaxSteps = T/dt
TDTimeStep = dt

omega = 0.24364803 # ~6.63 [eV]
#amplitude = sqrt(0.0001/3.51) # ~10e12 [W/cm^2]
amplitude = sqrt(0.0005/3.51) # ~5*10e12 [W/cm^2]
#amplitude = sqrt(0.0010/3.51) # ~10e13 [W/cm^2]

tau0 = 930.15 # ~45 fs
t0 = tau0

%TDExternalFields
  electric_field | 1 | 0 | 0 | omega | "my_function"
%

%TDFunctions
 "my_function" | tdf_cosinoidal | amplitude | tau0 | t0
%

TDOutput = geometry + laser + multipoles
Output = density
OutputFormat = plane_x + plane_y + plane_z + cube
OutputInterval = 100
