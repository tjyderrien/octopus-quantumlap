# Photoemission case to reproduce paper from Umbierto

CalculationMode = td

%Species
"Na_2D" | species_user_defined | potential_formula | "-1/sqrt(7.45+(r)^2)" | valence | 1
%

%ReducedCoordinates
 'Na_2D' | 0. | 0. | 0.
%

Dimensions = 2 
Units = atomic
# AbsorbingBoundaries =  
FromScratch = yes

TheoryLevel = independent_particles


# Simulation box
BoxShape = sphere
InnerRadius = 29
Radius = 30 #SphereRadius
Spacing = 1.3 #MeshSize

# Laser pulse
th = 0
px1 = cos(th)
py1 = sin(th)
px2 = cos(th)
py2 = sin(th)

omega = 2.214088 #a.u

pi = acos(-1.)
tau = 2.*pi/omega
t0 = 10. * tau #center of the pulse
tau0 = t0 #duration of the pulse

amplitude = 0.5
CEPA = 0. #Phase of the pulse CEP

%TDExternalFields
	vector_potential | px1 | py1 | 0 | omega | "FieldColorA"
%

%TDFunctions
	"FieldColorA" | tdf_from_expr | "amplitude * cos( pi / 2. * ( t - t0 - 2.*tau0 )/tau0)*step(2*tau0-t)"
	"phaseA" | tdf_cw | CEPA
%

TDTimeStep = 0.05 #atomic unit x 2.44e-17 s #NTD: 0.25 is enough! 
TDPropagationTime = 60*tau
TDPropagator = aetrs
TDExponentialMethod = lanczos
TDExpOrder = 16

# Absorbing boundary
# AbsorbingBoundaries = mask
# %ABShape
#  InnerRadius | Radius #With 1, absorption occurs super fast. Box may be not too big. 
# %

# Photo emission
PhotoElectronSpectrum = pes_mask
%PESMaskSize
 InnerRadius | Radius
%
# PESMaskMode = mask_mode #Simple
PESMaskMode = fullmask_mode
