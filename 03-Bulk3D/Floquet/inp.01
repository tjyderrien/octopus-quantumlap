# T.J.-Y. Derrien, N. Tancogne-Dejean, H. Appel, A. Rubio
# QuantumLaP project
# <derrien@fzu.cz>

CalculationMode = gs
ExperimentalFeatures=yes
FromScratch = yes
# Units = atomic #eV_Angstrom is a false unit system! ;)
# UnitsXYZFiles = Angstrom #TODO: this feature will be removed when we will have our branch
PeriodicDimensions = 3

# Conversion factors
aAngstrom = 5.431 #Angstrom (experimental value)
AngstromPerBohr = 0.52917721067 #AngstromPerBohr
a = aAngstrom / AngstromPerBohr #Bohr

# Simulation box size
m = 1 #X blocks: to be replaced by script
n = 1 #Z blocks: to be replaced by script 

# Optimization
# PoissonFFTKernel = planar
# ParStates = auto
# ParDomains = no #crashes if made per state only

# Mesh parameters
BoxShape = parallelepiped
%Spacing
	0.434637008855 | 0.434637008855 | 0.434637008855 #to be replaced by script
%

%Lsize #! Lsize is half of the box...
	0.5*m*a | 0.5*m*a | 0.5*m*a #(n*a + Lvac)*0.5
%

# Using external file
XYZCoordinates = "Si.xyz"



%KPointsGrid
  8 | 8 | 8
%

##### CONVERGENCE OPTIMIZATION
ConvRelDens = 1e-9 #is the right value. Just playing for non-unicity of solutions.
KPointsUseSymmetries = no
ExtraStates = 10 #With Floquet: add more extra states. Otherwise 1 is okay'.  

# smearing = 0.0002
# SmearingFunction=fermi_dirac

MaximumIter=1000
Mixing = 0.05

### OUTPUTS
Output = dos + density + potential + geometry
OutputFormat = xyz + vtk #OpenDX, UCSF Chimera
