CalculationMode = gs
ExperimentalFeatures=yes
#FromScratch = yes
# Units = atomic #eV_Angstrom is a false unit system! ;)
# UnitsXYZFiles = Angstrom #TODO: this feature will be removed when we will have our branch
PeriodicDimensions = 3

# Initial temperature
# RandomVelocityTemp = 300e0

# Conversion factors
aAngstrom = 5.431 #Angstrom (experimental value)
AngstromPerBohr = 0.52917721067 #AngstromPerBohr
a = aAngstrom / AngstromPerBohr #Bohr

# Simulation box size
m = 1 #X blocks: to be replaced by script
n = 1 #Z blocks: to be replaced by script 

# Optimization
# PoissonFFTKernel = planar
ParKPoints = auto #auto
ParStates = no
ParDomains = no #crashes if made per state only

# Mesh parameters
BoxShape = parallelepiped
%Spacing
	# 0.434637008855 | 0.434637008855 | 0.434637008855 #to be replaced by script
        0.434637008855 | 0.434637008855 | 0.434637008855
%

%LatticeParameters #noncubic cells
  m*a | m*a | m*a
%

%LatticeVectors
  0.0 | 0.5 | 0.5
  0.5 | 0.0 | 0.5
  0.5 | 0.5 | 0.0
%

# %Lsize #! Lsize is half of the box...
# 	0.5*m*a | 0.5*m*a | 0.5*m*a #(n*a + Lvac)*0.5
# %

# Using external file
# XYZCoordinates = "Si.xyz"

%ReducedCoordinates
 "Si" | 0.0 | 0.0 | 0.0
 "Si" | 1/4 | 1/4 | 1/4
%


%KPointsGrid
#  12 | 12 | 12
   8 | 8 | 8
   0.0 | 0.5 | 0.5
   0.5 | 0.0 | 0.0
   0   | 0.5 | 0
   0   | 0   | 0.5
%

kpts=100

%KPointsPath
# Consistency problem: if using the primitive cell for atmos, one has to introduced kPointsPath in b1b2b3 basis.
# If introducing cubic cell for atoms, one has to introduce KPointsPath in xyz basis.
### Proposition from MaterialsCloud.org
# Suggested by k-point path generator: Γ—X—U|K—Γ—L—W—X  (https://tools.materialscloud.org/seekpath/compute/process_structure/)
# Since it is not contiguous, we attempt to put 0 on the discontinuity.
 kpts | kpts | 0 | kpts | kpts | kpts | kpts
 0     | 0     | 0     #Gamma
 0.5   | 0     | 0.5   #X
 0.625 | 0.25  | 0.625 #U|
 0.375 | 0.375 | 0.75  #K
 0     | 0     | 0     #Gamma
 0.5   | 0.5   | 0.5   #L
 0.5   | 0.25  | 0.75  #W
 0.5   | 0     | 0.5   #X
%


##### CONVERGENCE OPTIMIZATION
ConvRelDens = 1e-9 #is the right value. Just playing for non-unicity of solutions.
KPointsUseSymmetries = no
# %SymmetryBreakDir #laser direction, where we gonna break symmetry
#  1 | 0 | 0
#%

ExtraStates = 4

# smearing = 0.0002
# SmearingFunction=fermi_dirac

# LCAOstart = lcao_simple #self-consistent starter

MaximumIter=200
# Mixing = 0.05

### OUTPUTS
Output = dos + density + potential + geometry + el_pressure + matrix_elements + pol_density

### GS matrix elements (useful for Floquet)
OutputMatrixElements = dipole #ks_multipoles + momentum
# OutputMEMultipoles = 1 #works in ParDomain. Fails in others. #Warning: this is not what we need for Floquet. 
OutputMEStart = 2
OutputMEEnd = 7

OutputFormat = xyz + vtk #OpenDX, UCSF Chimera
# XCFunctional = mgga_x_tb09 + lda_c_pw #this will be added automatically
# FilterPotentials = filter_none        #this will be added automatically
XCFunctional = lda_x + lda_c_pz_mod
