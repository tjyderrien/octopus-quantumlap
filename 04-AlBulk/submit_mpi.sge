#######################################################
#example SGE batch script for a plain MPI program using
#512 cores (16 nodes x 32 cores per node) with 32 MPI 
#tasks per node
#executed under the intel runtime 
#######################################################

## run in /bin/bash
#$ -S /bin/bash
## do not join stdout and stderr
#$ -j n
## name of the job
#$ -N silicon_tddft
## execute job from the current working directory
#$ -cwd
## send mail
#$ -m abe
## Email address
#$ -M derrien@fzu.cz
## request 16 nodes (x 32 cores), must be a multiple of 32  
#$ -pe impi_hydra 832
## run for 30 minutes
#$ -l h_rt=24:00:00
# Reserve resources
#$ -R y

# module purge 
# module load intel impi
# module load nfft/3.2.4

module purge
module load icc/2017.7.259-GCC-6.3.0-2.27
module load ifort/2017.7.259-GCC-6.3.0-2.27
module load impi/2017.4.239-iccifort-2017.7.259-GCC-6.3.0-2.27
module load imkl/2017.4.239-iimpi-2017c
module load libxc/4.2.3-intel-2017a
module load GSL/2.5-intel-2017a
module load FFTW/3.3.6-intel-2017a
module load HDF5/1.10.2-intel-2017a
module load netCDF/4.4.1.1-intel-2017a

# LD_LIBRARY_PATH=/scratch/tjyderriien/nfft/3.2.4/lib:$LD_LIBRARY_PATH

# module load octopus/5.0.0

## to save memory at high core counts, the "connectionless user datagram protocol" 
## can be enabled (might come at the expense of speed)
## see https://software.intel.com/en-us/articles/dapl-ud-support-in-intel-mpi-library
# export I_MPI_DAPL_UD=1

##gather MPI statistics to be analyzed with itac's mps tool
# export I_MPI_STATS=all

##gather MPI debug information (high verbosity)
# export I_MPI_DEBUG=5

# mpiexec -n $NSLOTS octopus_mpi
# ./start.sh
# RunningTrunc=/scratch/tjyderri/octopus-svn-15067/src/main

# JUST TO EXECUTE ONE RUN
LocalComputer=$( uname -a | awk '{ print $2 }' )
if [[ ${LocalComputer} == *"hydra"* ]]; then
	RunningTrunc=/ptmp/tjyderri/octopus-svn-15667/trunk/bin
else
#	RunningTrunc=/scratch/tjyderri/octopus-svn-15246/bin
        RunningTrunc=/scratch/tjyderri/octopus-trunk/bin
fi
echo "/!\ Please control version number. octopus_mpi --> octopus for version 15246."
mpiexec -n $NSLOTS $RunningTrunc/octopus >& run.txt
