#!/bin/bash

## machines.env takes care of loading modules for basic usage
## modules.env takes care of centralizing all modules for octopus running on a cluster.

LoadOctopusSalomonModulesFortran2020() {
module purge
module load iccifort/2020.0.166
module load iimpi/2020a
module load imkl/2020.0.166-iimpi-2020a
export MKL_HOME=/apps/all/imkl/2020.0.166-iimpi-2020a #May 21st, 8:12am <derrien@fzu.cz> 
module load libxc/4.3.4-intel-2020a
module load GSL/2.5-intel-2020a
export GLS_HOME=/apps/all/GSL/2.5-intel-2020a
module load FFTW/3.3.8-intel-2020a
export FFTW_HOME=/apps/all/FFTW/3.3.8-intel-2020a
module load HDF5/1.10.6-intel-2020a

module load libyaml/0.2.2
export YAML_HOME=/apps/all/libyaml/0.2.2
}

LoadOctopusPrometheusModulesFortran2018() {
module purge
module load plgrid/tools/intel/18.0.0
module load plgrid/tools/impi/2018
module load plgrid/libs/mkl/2018.0.0
module load plgrid/libs/libxc/4.2.3
module load plgrid/libs/gsl/2.4
module load plgrid/libs/fftw/3.3.7
module load plgrid/libs/hdf5/1.10.4
module load plgrid/libs/netcdf/4.7.0
export LIBXC_HOME=/net/software/local/libxc/4.2.3
}
