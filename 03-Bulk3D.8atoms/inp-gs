# TODO: transfer the interface to the Python code, directly, so that we can plot figures in atomic units. 
# For now, interface Hartree <-> SI is managed here.

# Some manual commands
# RelaxationTimeSI = 100e-15 #[s]

# Some constants
cSI = 299792458e0
eVperHartree = 27.21138505e0 #Wikipedia [Hartree]
BohrRadius = 5.2917721067e-11 #m, Wikipedia [Bohr radius]
HartreePerBohr = eVperHartree / BohrRadius
hSI = 6.626070040e-34
heVs = 4.135667662e-15
ecSI = 1.6021766208e-19
hbarSI = 1.054571800e-34
TimeAUtoSI = hbarSI / eVperHartree / ecSI
lightvelocity = 137.035999139 #light velocity = 1e0/fine structure constant [https://en.wikipedia.org/wiki/Fine-structure_constant]

# To be replaced by script
## Pulse wavelengths ##
lambdaA = 2656e-9 #SI: s-1, to be replaced by script
lambdaB = 400e-9 #SI: s-1, to be replaced by script
## Field amplitude
EfieldAsi = 1.4E9 #V/m, to be replaced by script
EfieldBsi = 0E0 #V/m, to be replaced by script
## Pulse duration 
tauAsi = 33.203125e-15 #This is FWHM of the Gaussian pulse
tauBsi = 30e-15 #This is FWHM of the Gaussian pulse
## Double pulse delay
pulseDelaySI = 0e-15
## Envelope phase CEP
CEPA = pi*0.0
CEPB = pi*-0.45 
# shifting by pi/2.
CEPA = CEPA + pi/2.
CEPB = CEPB + pi/2.
## Computational time
ComputingTimeValueSI = 1.0982555915816267e-13

# Conversion to a.u.
## Pulse wavelengths ##
# omegaAsi = 2.*pi*cSI / lambdaA
# omegaBsi = 2.*pi*cSI / lambdaB
# omegaA = omegaAsi * hbarSI / eVperHartree / ecSI #Hartree = s-1 / eVperHartree 
# omegaB = omegaBsi * hbarSI / eVperHartree / ecSI #Hartree = s-1 / eVperHartree
omegaA = heVs * cSI / lambdaA / eVperHartree
omegaB = heVs * cSI / lambdaB / eVperHartree
## Field amplitude
EfieldA = EfieldAsi / HartreePerBohr
EfieldB = EfieldBsi / HartreePerBohr
## Pulse duration 
tauA = tauAsi / TimeAUtoSI
tauB = tauBsi / TimeAUtoSI
# t0 = max(tauA, tauB) #useless to use tauB there
t0 = 1.1*tauA #(we must not start the run on the pulse start!)
t0Gauss = 2.*t0
GaussianRatio = 2.*sqrt(2. * ln(2.))
sigmaTauA = tauA / GaussianRatio
sigmaTauB = tauB / GaussianRatio

## Double pulse delay
pulseDelay = pulseDelaySI / TimeAUtoSI
t1 = t0 + pulseDelay
t1Gauss = t0Gauss + pulseDelay
## Relaxation time (to observe Ehrenfest dynamics and band structure modifications)
# RelaxationTime = RelaxationTimeSI #/ TimeAUtoSI #! THere is no need to convert it! Everything is done at the end. 

## Vector field amplitude

# /!\ Assumption is made on the temporal integration of Efield
amplitudeA = EfieldA * lightvelocity / omegaA
amplitudeB = EfieldB * lightvelocity / omegaB

## Simulation time management
ComputingTime = ComputingTimeValueSI / TimeAUtoSI
#4.*sigmaTau1 + pulseDelay + RelaxationTime #time of computation

# Predicting which simulation axis will be broken during excitation. 
theta_inc = pi*0 #angle of incidence of the laser
ell = 0. #ellipticity
# %SymmetryBreakDir
#  cos(theta_inc)-i*ell*sin(theta_inc) | sin(theta_inc)+i*ell*cos(theta_inc) | 0.0
# %

# %SymmetryBreakDir
#  cos(theta_inc)-i*ell*sin(theta_inc) | sin(theta_inc)+i*ell*cos(theta_inc) | 0.0
#    sqrt(2)/6*(3*cos(theta_inc)+sqrt(3)*sin(theta_inc)) | -sqrt(2)/6*(3*cos(theta_inc)-sqrt(3)*sin(theta_inc)) | -sqrt(6)/3*sin(theta_inc)
#% 


#TODO: script the change of polarization
th1 = pi*0 #scripted (units are same as for CEP, we multiply by pi only here to simplify)
th2 = 0.+th1      #Scripted

px1 =  sqrt(2)/6*(3*cos(th1)+sqrt(3)*sin(th1)) #cos(th1)
py1 = -sqrt(2)/6*(3*cos(th1)-sqrt(3)*sin(th1)) #sin(th1)
pz1 = -sqrt(6)/3*sin(th1)
 #cos(th1)
px2 = cos(th2)
py2 = sin(th2)

# Duration of the rise is linked with laser wavelength
tauRise = 2.*pi/omegaA #no longer true when input is from a file
