  "FieldColorB-TopHat" | tdf_from_expr | "amplitudeB * step(t-0.5*tauA-t1Gauss)*step(0.5*tauA - (t - t1Gauss) )"
    "FieldColorA-SinFourth" | tdf_from_expr | "amplitudeA * sin(0.5*pi*((t-t0-tauA)/tauA))^4 * step(t-t0+tauA) * (1e0 - step(t-t0-tauA) )"
  "FieldColorB-SinFourth" | tdf_from_expr | "amplitudeB * sin(0.5*pi*((t-t1-tauB)/tauB))^4 * step(t-t1+tauB) * (1e0 - step(t-t1-tauB) )"
