<Group labelreference="L6" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">Mat:=proc(NS,NE,kp1,km1,k2)


delta:=proc(a,b) piecewise(a=b,1,0); end proc;
Baseset:=proc(sm,em,cm,pm) global B; global Bdim;
i:=1;

for si from 0 to sm 
    do 
       for ei from 0 to em
           do
              for ci from 0 to cm
                  do 
                     for pri from 0 to pm 
                         do
                         if ei+ci = em then    
                         if si+ci+pri = sm then                            
                         B[i]:=(si,ei,ci,pri): 
                         i:=i+1;
                         end if;
                         end if;
                         end do;
                  end do;
              end do;
        end do;
    Bdim:=i-1;
end proc;
Baseset(NS,NE,NE,NS):

ME:=proc(si,sit,ei,eit,ci,cit,pri,prit,kp1,km1,k2) (-delta(ei, eit)*delta(ci, cit)*((k2+km1)*cit+kp1*sit*eit)*delta(si, sit)+kp1*sit*eit*delta(si, sit-1)*delta(ei, eit-1)*delta(ci, cit+1)+km1*cit*delta(si, sit+1)*delta(ei, eit+1)*delta(ci, cit-1))*delta(pri, prit)+k2*cit*delta(si, sit)*delta(ei, eit+1)*delta(ci, cit-1)*delta(pri, prit+1); end proc;

element:= proc(i,j,kp1,km1,k2) ME(B[i][1],B[j][1],B[i][2],B[j][2],B[i][3],B[j][3],B[i][4],B[j][4],kp1,km1,k2); end proc;

   for i from 1 to Bdim do
       for j from 1 to Bdim do
       A[i,j]:= element(i,j,kp1,km1,k2);
       end do;
   end do;
Mt:= Array(1..Bdim,1..Bdim,(i,j)-&gt; A[i,j]);
end proc;
</Text-field>
</Input>
