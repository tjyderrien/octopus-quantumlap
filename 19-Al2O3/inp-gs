##### CONVERGENCE OPTIMIZATION
ConvRelDens = 1e-9 #is the right value. Just playing for non-unicity of solutions.
KPointsUseSymmetries = yes

theta_inc = pi*theta1_inp #angle of incidence of the laser (scripted replacement)
ell = 1. #ellipticity
# %SymmetryBreakDir
#  cos(theta_inc)-i*ell*sin(theta_inc) | sin(theta_inc)+i*ell*cos(theta_inc) | 0.0
