#!/bin/bash

#######################################################
#example SGE batch script for a plain MPI program using
#512 cores (16 nodes x 32 cores per node) with 32 MPI 
#tasks per node
#executed under the intel runtime 
#######################################################
## run in /bin/bash
#$ -S /bin/bash
## do not join stdout and stderr
#$ -j n
## name of the job
#$ -N silicon_aims
## execute job from the current working directory
#$ -cwd
## send mail
#$ -m abe
## Email address
#$ -M derrien@fzu.cz
## request 16 nodes (x 32 cores), must be a multiple of 32  
#$ -pe impi_hydra 512
## run for some time
#$ -l h_rt=08:00:00
# Priority
#$ -R y

module purge
module load intel impi

set -e

# Just loading variables for FHI-aims
cd ../Tutorial2/reference/
source tut2.env
cd -

python_calc () {
    python -c "print ($@)"
}

# 1. CREATE THE MULTIPLE SAMPLES
# 2. Check k-point convergence for each of them
SampleZ=6
# SampleX=1
for SampleX in `seq 4 1 12`; do #NumberOfAtoms in Z direction
# for SampleZ in `seq 1 1 20`; do #NumberOfAtoms in Z direction
	# create new directory
	dirsample="Si-${SampleZ}x${SampleX}x${SampleX}-L50"
	mkdir -p ${dirsample}
	cd ${dirsample}
	# build the sample
	../../../Samples/Si100-H/write-geom.py ${SampleZ} ${SampleX} > geometry.in
	# get the controls from parent directory
#	cp ../control-*.in .
	# generation of k-points
	for dir in 1; do
		dirname="k-1x"$dir"x"$dir
		mkdir -p $dirname
		cd $dirname
		# Prepare control.in
		cp ../geometry.in .
		cp ../../control-I.in control.in
		echo >>control.in
		echo >>control.in "# k-point grid"
		echo >>control.in
		echo >>control.in "  k_grid 1 $dir $dir"
		echo >>control.in
		cat >> control.in ../../control-II.in
		cat >> control.in ../../control-III.in
		cat >> control.in ../../control-IV.in
	      	# Main loop over different lattice constants
		# start the job!!
		mpiexec -n $NSLOTS $AIMSBIN < /dev/null > aims.out
		cd - >/dev/null
	done
	cd ..
done
