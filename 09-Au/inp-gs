CalculationMode = gs #unocc

PeriodicDimensions = 3

## INPUT WITH PRIMITIVE CELL
a = 4.175*angstrom #Value of Zhigilei PRB 2008 #interatomic distance, more clear. 
# a = 2.949546*angstrom #size of the primitive cell in half filled trigonal form. #warning: relaxed geometry has 2.879 A
# angle = 90. #degrees, indeed
angle_deg = 60. #deg
angle = angle_deg/180.*pi #rad

%Spacing
 MeshSizeX_AU | MeshSizeX_AU | MeshSizeZ_AU
%

BoxShape = parallelepiped

# Lsize = a/2

ParDomains = yes

KPointsUseSymmetries = yes

# %LatticeVectors
#   1.  | 0.0 | 0.0
#   0.5 | sqrt(3.)/2. | 0.0
#   cos(angle) | -(cos(angle)-1.)/tan(angle) | sqrt(2.*cos(angle)+1.)*(1.-cos(angle))/(sin(angle)) #sqrt(2.)*sqrt(3.)/3. #try with minus for the element 3,3 in case 
# %

### Symmetric frame, according to Duke University. 
%LatticeVectors
  0   | 0.5 | 0.5
  0.5 | 0   | 0.5
  0.5 | 0.5 | 0
%      

%ReducedCoordinates #coordinates are between -0.5 and 0.5
# 'Au' | 0.25*a | 0.25*a | 0.25*a
# 'Au' | 0.75*a | 0.75*a | 0.25*a
# 'Au' | 0.25*a | 0.75*a | 0.75*a 
# 'Au' | 0.75*a | 0.25*a | 0.75*a
'Au' | 0 | 0 | 0
%

%LatticeParameters
  a | a | a
#  angle | angle | angle
%

# Predicting which simulation axis will be broken during excitation. 
theta_inc = 0. #angle of incidence of the laser
ell = 0. #ellipticity
%SymmetryBreakDir
 cos(theta_inc)-i*ell*sin(theta_inc) | sin(theta_inc)+i*ell*cos(theta_inc) | 0.0
%
#

%KPointsGrid
  kPointsValue | kPointsValue | kPointsValue
%

