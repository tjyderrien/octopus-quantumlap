CalculationMode = td

PeriodicDimensions = 3

## INPUT WITH CUBIC CELL
# a = 4.0796*angstrom #Bohr, size of the cubic cell
a = 2.949546*angstrom #size of the primitive cell #warning: relaxed geometry has 2.879 A.
# angle = 90. #degrees, indeed
angle_deg = 60. #deg
angle = angle_deg/180.*pi #rad

%Spacing
 MeshSizeX_AU | MeshSizeX_AU | MeshSizeZ_AU
%

BoxShape = parallelepiped

KPointsUseSymmetries = yes

%SymmetryBreakDir
 1.0 | 0.0 | 0.0
%

%LatticeVectors
  1.  | 0.0 | 0.0
  0.5 | sqrt(3.)/2. | 0.0
  cos(angle) | -(cos(angle)-1.)/tan(angle) | sqrt(2.*cos(angle)+1.)*(1.-cos(angle))/(sin(angle)) #sqrt(2.)*sqrt(3.)/3. #try with minus for the element 3,3 in case 
%


%ReducedCoordinates #coordinates are between -0.5 and 0.5
# 'Au' | 0.25*a | 0.25*a | 0.25*a
# 'Au' | 0.75*a | 0.75*a | 0.25*a
# 'Au' | 0.25*a | 0.75*a | 0.75*a 
# 'Au' | 0.75*a | 0.25*a | 0.75*a
'Au' | 0 | 0 | 0 #let's try at the minimum of the basis
%

%LatticeParameters
  a | a | a
  angle | angle | angle
%

%KPointsGrid
  kPointsValue | kPointsValue | kPointsValue
%

PseudopotentialSet = pseudodojo_lda
# PseudopotentialSet = pseudodojo_pbe
# PseudopotentialSet = pseudodojo_pbe_stringent
# PseudopotentialSet = pseudodojo_pbesol_stringent
# PseudopotentialSet = sg15
# XCFunctional = GGA_X_PBE + GGA_C_PBE
# XCFunctional = GGA_X_PBE_R
# XCFunctional = MGGA_X_PBE_GX
# FilterPotentials = filter_none

SmearingFunction = fermi_dirac
Smearing = 300./11600.*eV

ExtraStates = 4
ExtraStatesToConverge = 2 

ExperimentalFeatures = yes

FromScratch = yes

## Extracted from example of delayed kick from NTD testsuite for periodic solids.
ParStates = auto
ParDomains = yes
ParKPoints = auto
# CurrentDensity = gradient_corrected

Iau  = (sqrt(0E11)/sqrt(3.509470*1E16)) #Conversion in a.u.
omega = 0.5
Tpulse = 210

# %TDExternalFields
#   vector_potential | 1.0 | 0.0 | 0.0 | omega | "envelope_sin2"
# %

# %TDFunctions
#  "envelope_sin2" | tdf_from_expr | "-Iau/omega*c*sin(pi*t/Tpulse)^2*(1-step(t-Tpulse))"
# %

%GaugeVectorField
   1 | 0 | 0
%

GaugeFieldDelay =  0

# TDMaxSteps = 300

TDTimeStep = 0.25 #atomic unit x 2.44e-17 s #NTD: 0.25 is enough with Si. 
TDPropagationTime = ComputingTime
TDPropagator = aetrs #it was aetrs
TDExponentialMethod = lanczos
TDExpOrder = 16

TDOutput = energy + geometry + total_current + gauge_field + density + laser
