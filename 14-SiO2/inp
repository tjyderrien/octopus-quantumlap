CalculationMode = gs
ExperimentalFeatures=yes
FromScracth = yes
# Units = atomic #eV_Angstrom is a false unit system! ;)
# UnitsXYZFiles = Angstrom #TODO: this feature will be removed when we will have our branch
PeriodicDimensions = 3

# Initial temperature
# RandomVelocityTemp = 300e0

# Conversion factors
aAngstrom = 4.91343*angstrom #interactomic distance, experimental value from Landolt-Bornstein
cAngstrom = 5.40506*angstrom #idem 


## DATA FROM AVOGADRO 
a = 5.02778*angstrom #aAngstrom 
caxis = 5.51892*angstrom #cAngstrom 

# Simulation box size
m = 1 #X blocks: to be replaced by script
n = 1 #Z blocks: to be replaced by script 

# Optimization
# PoissonFFTKernel = planar
# ParKPoints = auto
# ParStates = auto
ParDomains = no #crashes if made per state only

# Mesh parameters
BoxShape = parallelepiped
%Spacing
	# 0.434637008855 | 0.434637008855 | 0.434637008855 #to be replaced by script
        0.283458918819 | 0.283458918819 | 0.283458918819
%

%LatticeParameters #noncubic cells
  m*a | m*a | m*caxis
%

%LatticeVectors #simply the primitive cell of the lattice type
  0.5 | -sqrt(3.)/2.| 0
  0.5 | sqrt(3.)/2. | 0
  0   | 0           | 1.
%

# %Lsize #! Lsize is half of the box...
# 	0.5*m*a | 0.5*m*a | 0.5*m*a #(n*a + Lvac)*0.5
# %

# Using external file
# XYZCoordinates = "Si.xyz"

%ReducedCoordinates
"Si" | 0.52272 | 0.52272 |  0.50000
"Si" | 0.47728 | 0.00000 |  0.16667
"Si" | 0.00000 | 0.47728 |  0.83333
"O"  | 0.58497 | 0.83926 |  0.37068
"O"  | 0.16074 | 0.74571 |  0.03734
"O"  | 0.25429 | 0.41503 |  0.70401
"O"  | 0.83926 | 0.58497 |  0.62932
"O"  | 0.74571 | 0.16074 |  0.96266
"O"  | 0.41503 | 0.25429 |  0.29599
%

kPointsValue=16

%KPointsGrid
   kPointsValue | kPointsValue | kPointsValue
%

kpts=30
%KPointsPath
# Gamma | M | K | Gamma | A | L | H | A|L | M|K | H
kpts | kpts | kpts | kpts | kpts | kpts
 0 | 0 | 0 #Gamma 
 0.5 | 0 | 0 #M
 1./3. | 1./3. | 0 # K
 0 | 0 | 0 # Gamma
 0 | 0 | 0.5 # A
 0.5 | 0 | 0.5 # L (ex?)
 1./3. | 1./3. | 0.5 # H
# A|L
# M|K
# 1./3. | 1./3. | 0.5 # H 
%


##### CONVERGENCE OPTIMIZATION
ConvRelDens = 1e-9 #is the right value. Just playing for non-unicity of solutions.
KPointsUseSymmetries = yes
%SymmetryBreakDir #laser direction, where we gonna break symmetry
  1 | 0 | 0
%

ExtraStates =0 #16 is enough for band structure.

# smearing = 0.0002
# SmearingFunction=fermi_dirac

# LCAOstart = lcao_simple #self-consistent starter

MaximumIter=200
# Mixing = 0.05

### OUTPUTS
Output = dos + density + potential + geometry
OutputFormat = xyz + vtk #OpenDX, UCSF Chimera
# XCFunctional = mgga_x_tb09 + lda_c_pw #this will be added automatically

DOSEnergyMin = -30*eV #-0.3674932248085465 #-10 eV, like Zhigilei
DOSEnergyMax = 30*eV #0.8452344170596571 #23 eV, like Zhigilei

FilterPotentials = filter_none        #this will be added automatically
XCFunctional = GGA_X_PBE + GGA_C_PBE
PseudopotentialSet = pseudodojo_pbe
