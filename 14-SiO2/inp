%KPointsGrid
  12 | 12 | 12
#  kPointsValue | kPointsValue | kPointsValue
#   0.5 | 0.5 | 0.5
#   0.5 | 0.0 | 0.0
#   0   | 0.5 | 0
#   0   | 0   | 0.5
%

kpts=30
%KPointsPath
# Gamma | M | K | Gamma | A | L | H | A|L | M|K | H
kpts | kpts | kpts | kpts | kpts | kpts | kpts
0 | 0 | 0 #Gamma 
0.5 | 0 | 0 #M
1./3. | 1./3. | 0 # K
0 | 0 | 0 # Gamma
0 | 0 | 0.5 # A
0.5 | 0 | 0.5 # L (ex?)
1./3. | 1./3. | 0.5 # H
