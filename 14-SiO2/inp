CalculationMode = gs
ExperimentalFeatures=yes
FromScracth = yes
# Units = atomic #eV_Angstrom is a false unit system! ;)
# UnitsXYZFiles = Angstrom #TODO: this feature will be removed when we will have our branch
PeriodicDimensions = 3

# Initial temperature
# RandomVelocityTemp = 300e0

# Conversion factors
aAngstrom = 5.02778*angstrom #Angstrom (interactomic distance, experimental value)
cAngstrom = 5.51892*angstrom #Angstrom
AngstromPerBohr = 0.52917721067 #AngstromPerBohr
a = aAngstrom #/ AngstromPerBohr #Bohr
caxis = cAngstrom #/ AngstromPerBohr

# Simulation box size
m = 1 #X blocks: to be replaced by script
n = 1 #Z blocks: to be replaced by script 

# Optimization
# PoissonFFTKernel = planar
# ParKPoints = auto
# ParStates = auto
ParDomains = auto #crashes if made per state only

# Mesh parameters
BoxShape = parallelepiped
%Spacing
	0.434637008855 | 0.434637008855 | 0.434637008855 #to be replaced by script
        # MeshSizeX_AU | MeshSizeX_AU | MeshSizeZ_AU
%

%LatticeParameters #noncubic cells
  m*a | m*a | m*caxis
%

%LatticeVectors #simply the primitive cell of the lattice type with row representation. But has to use exact numbers, not rounded off by Avogadro.
# Space group 1 ?!
#  0.19889 |  0.00000 |  0.00000
#  0.11483 |  0.22966 |  0.00000
#  0.00000 |  0.00000 |  0.18119
#  Computed by hand #row vectors. Space group 5 ?!
  1  | 0         | 0
-1/2 | sqrt(3)/2 | 0
  0  | 0         | 1
%

# %Lsize #! Lsize is half of the box...
# 	0.5*m*a | 0.5*m*a | 0.5*m*a #(n*a + Lvac)*0.5
