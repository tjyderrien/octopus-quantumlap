# Building up pulses
%TDExternalFields
#   vector_potential | px1 | py1 | 0 | omegaA | "FieldColorA" | "phaseA"
#   vector_potential | px2 | py2 | 0 | omegaB | "FieldColorB" | "phaseB"
    vector_potential | px1 | py1 | 0 | omegaA | "FieldShapeA" | "phaseA" #FieldShape is a keyword for the bash scripts. Dont remove it.
    vector_potential | px2 | py2 | 0 | omegaB | "FieldShapeB" | "phaseB"
%

%TDFunctions
  "FieldColorA-Gaussian" | tdf_from_expr | "amplitudeA * exp(-0.5*((t-t0Gauss)/sigmaTauA)^2)" #GAUSSIAN 1
  "FieldColorB-Gaussian" | tdf_from_expr | "amplitudeB * exp(-0.5*((t-t1Gauss)/sigmaTauB)^2)" # GAUSSIAN 2
  "phaseA" | tdf_cw | CEPA #GAUSSIAN 1
  "phaseB" | tdf_cw | CEPB #GAUSSIAN 2
  "FieldColorA-SinSquared" | tdf_from_expr | "amplitudeA * sin(0.5*pi*((t-t0-tauA)/tauA))^2 * step(t-t0+tauA) * (1e0 - step(t-t0-tauA) )"
  "FieldColorB-SinSquared" | tdf_from_expr | "amplitudeB * sin(0.5*pi*((t-t1-tauB)/tauB))^2 * step(t-t1+tauB) * (1e0 - step(t-t1-tauB) )"
  "FieldColorA-TopHat" | tdf_from_expr | "amplitudeA * step(t-0.5*tauA-t0Gauss)*step(0.5*tauA - (t - t0Gauss) )"
  "FieldColorB-TopHat" | tdf_from_expr | "amplitudeB * step(t-0.5*tauA-t1Gauss)*step(0.5*tauA - (t - t1Gauss) )"
