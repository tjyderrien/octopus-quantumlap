CalculationMode = gs

PeriodicDimensions = 3

## INPUT WITH CUBIC CELL
# a = 3.147 #Angstroms. Given by ASE (parallelepipedic) #but the octopus input is in Bohr, right?
# a = 5.9469681168157855*bohr #, size of the cubic cell
# angle = 90. #degrees, indeed

## INPUT WITH PRIMITIVE CELL
# a = 2.74324*angstrom #Avogadro input. Good for lower triangular primitive cell. 
a = 3.1472*angstrom #interatomic distance: REF: Landolt-Bornstein, New Series III/24b p.22
angle = 109.47122 #*pi/180. #deg

# a = 2.743 Angstr. #DOI: 10.17188/1189253
# a = 5.183518762130822 #Bohr

# Spacing = a/16
Spacing = MeshSizeX_AU #to be replaced by script

BoxShape = parallelepiped

# Lsize = a/2

# ParDomains = yes

KPointsUseSymmetries = yes

%SymmetryBreakDir
 1.0 | 0.0 | 0.0
%

%ReducedCoordinates #coordinates are between -0.5 and 0.5
 'Mo' | 0.0 | 0.0 | 0.0
%

### basis is oriented along a1 (Avogadro software style)
# %LatticeVectors
#   2.74324/a |  0.00000   0.00000
#  -0.91441/a |  2.58635/a | 0.00000
#  -0.91441/a | -1.29317/a | 2.23984/a
# %

### Basis is symmetric (Duke University style)
%LatticeVectors
  -0.5 | 0.5  | 0.5
   0.5 | -0.5 | 0.5
   0.5 | 0.5  | -0.5
%

%LatticeParameters
  a | a | a
#  angle | angle | angle
%

%KPointsGrid
  kPointsValue | kPointsValue | kPointsValue #to be replaced by script
  # 16 | 16 | 16
%

# KpointPath Resolution
KppR=30
#
%kPointsPath #Mo: Gamma H N Gamma P H|P N (according to http://www.cryst.ehu.es/cgi-bin/cryst/programs/nph-kv-list)
   KppR | KppR | KppR | KppR | KppR | KppR
      0    | 0     | 0     #Gamma
      0.5  | -0.5  | 0.5   #H
      0    | 0     | 0.5   #N
      0    | 0     | 0.0   #Gamma
      0.25 | 0.25  | 0.25  #P
      0.5  | -0.5  | 0.5   #H(|P)
      0    | 0     | 0.5   #N
%
PseudopotentialSet = pseudodojo_lda
# PseudopotentialSet = pseudodojo_pbe
# PseudopotentialSet = pseudodojo_pbe_stringent
# PseudopotentialSet = pseudodojo_pbesol_stringent
# PseudopotentialSet = sg15
# XCFunctional = GGA_X_PBE + GGA_C_PBE
# XCFunctional = GGA_X_PBE_R
# XCFunctional = MGGA_X_PBE_GX
# FilterPotentials = filter_none

SmearingFunction = fermi_dirac
Smearing = SmearingTe*eV #300 K

Output = geometry + dos #+ matrix_elements
# OutputMatrixElements=dipole #generates HUGE load on the I/O

OutputFormat = xyz

DOSEnergyMin = -10*eV #-0.3674932248085465 #-10 eV, like Zhigilei
DOSEnergyMax = 23*eV #0.8452344170596571 #23 eV, like Zhigilei

# DOSEnergyPoints = 1000
DOSGamma = 0.2*ev #0.2 eV: advised by NTD. 3E-4 #Default: 8E-3. 3E-4 is Zhigilei's value in Ha. 

ExtraStates = 4
ExtraStatesToConverge = 0
ConvRelDens = 1e-9

ExperimentalFeatures = yes

FromScratch = yes
