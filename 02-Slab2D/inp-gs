# used with octopus svn revision 15009
# used with 1188/2376 cpu cores (2376 cpu cores = 18*6 kpoints * 22 states) 

CalculationMode = gs
ExperimentalFeatures=yes
FromScratch = yes
Units = atomic #eV_Angstrom is a false unit system! ;)
UnitsXYZFiles = Angstrom
PeriodicDimensions = 2

# Conversion factors
aAngstrom = 5.431 #Angstrom (experimental value)
AngstromPerBohr = 0.52917721067 #AngstromPerBohr
a = aAngstrom / AngstromPerBohr #Bohr

# Simulation box size
m = SizeOfTheBox #X blocks: to be replaced by script
n = NumberOfBlocks #Z blocks: to be replaced by script 
Lvac = SizeOfVacuum #(Angstrum) to be replace by script

# Optimization
PoissonFFTKernel = planar
# ParStates = auto
# ParDomains = no #crashes if made per state only

# Mesh parameters
BoxShape = parallelepiped
%Spacing
	MeshSizeX | MeshSizeX | MeshSizeZ #to be replaced by script
%

%Lsize #! Lsize is half of the box...
	0.5*m*a/sqrt(2.) | 0.5*m*a/sqrt(2.) | (n*a + Lvac)*0.5
%

# Using external file
XYZCoordinates = "Si.xyz"

%KPointsGrid
  kPointsValue | kPointsValue | 1
%

##### CONVERGENCE OPTIMIZATION
ConvRelDens = 1e-9
KPointsUseSymmetries = no
ExtraStates = 32

# smearing = 0.0002
# SmearingFunction=fermi_dirac

MaximumIter=1000
Mixing = 0.05

### OUTPUTS
Output = dos
OutputFormat = xyz

Output = density + potential + geometry
#OutputFormat = cube #VisIt
OutputFormat = vtk #OpenDX, UCSF Chimera
