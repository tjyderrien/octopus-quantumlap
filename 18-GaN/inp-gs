CalculationMode = gs
ExperimentalFeatures=yes
FromScratch = yes
PeriodicDimensions = 3

# Initial temperature
# RandomVelocityTemp = 300e0

## DATA FROM AVOGADRO 
a = 3.21629*angstrom #aAngstrom 
caxis = 5.23996*angstrom #cAngstrom 

# Simulation box size
m = 1 #X blocks: to be replaced by script
n = 1 #Z blocks: to be replaced by script 

# Optimization
# PoissonFFTKernel = planar
ParKPoints = auto
# ParStates = auto
# ParDomains = yes #crashes if made per state only

# Mesh parameters
BoxShape = parallelepiped
%Spacing
	# 0.434637008855 | 0.434637008855 | 0.434637008855 #to be replaced by script
        MeshSizeX_AU | MeshSizeX_AU | MeshSizeZ_AU
%

%LatticeParameters #noncubic cells
  m*a | m*a | m*caxis
%

# %LatticeVectors #simply the primitive cell of the lattice type
#  0.5 | -sqrt(3.)/2| 0
#  0.5 | sqrt(3.)/2 | 0
#  0   | 0           | 1
#%

%LatticeVectors #with 4 atoms cell. Equiv. 8-atoms cell also exist (space group 36). 
    1  |      0      | 0
   1/2 | (3**0.5)/2  | 0
    0  |      0      | 1
%

# Using external file
# XYZCoordinates = "Si.xyz"

# Refined using SPG lib
%ReducedCoordinates
  "Ga" | 0.333333 | 0.666667 | 0.999120
  "Ga" | 0.666667 | 0.333333 | 0.499120
  "N"  | 0.333333 | 0.666667 | 0.375880
  "N"  | 0.666667 | 0.333333 | 0.875880
%

%KPointsGrid
   kPointsValue | kPointsValue | kPointsValue
%

kpts=100 #sufficient density is necessary!! 100 is usually too low!
%KPointsPath
# Path MaterialsPojrect: Γ—M—K—Γ—A—L—H—A|L—M|K—H
# Path GrazUni:          Γ—M—K—Γ—A—L—H—A|L—M|K—H as well
# Path SeeKpath lib:     Γ—M—K—Γ—A—L—H—A|L—M|H—K 
kpts | kpts | kpts | kpts | kpts | kpts | kpts | 0 | kpts | 0 | kpts
 0     | 0     | 0 #Gamma
 0.5   | 0     | 0 #M
 1./3. | 1./3. | 0 # K
 0     | 0     | 0 # Gamma
 0     | 0     | 0.5 # A
 0.5   | 0     | 0.5 # L
 1./3. | 1./3. | 0.5 # H
 0     | 0     | 0.5 #A
 0.5   | 0     | 0.5 # L
 0.5   | 0     | 0 #M
 1./3. | 1./3. | 0.5 # H
 1./3. | 1./3. | 0 # K
%


##### CONVERGENCE OPTIMIZATION
ConvRelDens = 1e-9 #is the right value. Just playing for non-unicity of solutions.
KPointsUseSymmetries = yes

# %SymmetryBreakDir #laser direction, where we gonna break symmetry
#  1 | 0 | 0
# %

ExtraStates = 8 #0 #16 is enough for band structure.

# smearing = 0.0002
# SmearingFunction=fermi_dirac

# LCAOstart = lcao_simple #self-consistent starter

MaximumIter=200
# Mixing = 0.05

### OUTPUTS
Output =  dos  +  density  +  potential +  geometry #+ matrix_elements

OutputFormat = xyz + vtk #OpenDX, UCSF Chimera
# XCFunctional = mgga_x_tb09 + lda_c_pw #this will be added automatically

# OutputMatrixElements=dipole

DOSEnergyMin = -30*eV #-0.3674932248085465 #-10 eV, like Zhigilei
DOSEnergyMax = 30*eV #0.8452344170596571 #23 eV, like Zhigilei

PseudopotentialSet = pseudodojo_lda
# XCFunctional = GGA_X_PBE + GGA_C_PBE
FilterPotentials = filter_none        #this will be added automatically
