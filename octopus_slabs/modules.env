#!/bin/bash

## machines.env takes care of loading modules for basic usage
## modules.env takes care of centralizing all modules for octopus running on a cluster.

LoadOctopusSalomonModulesFortran2020() {
    module purge
    module load iccifort/2020.0.166
    module load iimpi/2020a
    module load imkl/2020.0.166-iimpi-2020a
    export MKL_HOME=/apps/all/imkl/2020.0.166-iimpi-2020a #May 21st, 8:12am <derrien@fzu.cz> 
    module load libxc/4.3.4-intel-2020a
    module load GSL/2.5-intel-2020a
    export GLS_HOME=/apps/all/GSL/2.5-intel-2020a
    module load FFTW/3.3.8-intel-2020a
    export FFTW_HOME=/apps/all/FFTW/3.3.8-intel-2020a
    module load HDF5/1.10.6-intel-2020a

    module load libyaml/0.2.2
    export YAML_HOME=/apps/all/libyaml/0.2.2
}

LoadOctopusPrometheusModulesFortran2018() {
    module purge
    module load plgrid/tools/intel/18.0.0
    module load plgrid/tools/impi/2018
    module load plgrid/libs/mkl/2018.0.0
    module load plgrid/libs/libxc/4.2.3
    module load plgrid/libs/gsl/2.4
    module load plgrid/libs/fftw/3.3.7
    module load plgrid/libs/hdf5/1.10.4
    module load plgrid/libs/netcdf/4.7.0
    export LIBXC_HOME=/net/software/local/libxc/4.2.3
}


LoadOctopusBarboraModulesFortran2021() {
module purge
module load Autotools/20200321-GCCcore-10.2.0
module load iccifort/2020.4.304
module load iimpi/2020b
module load imkl/2020.4.304-iimpi-2020b
export MKL_HOME=/apps/all/imkl/2020.4.304-iimpi-2020b
module load libxc/4.3.4-intel-2020a #sends iccifort back to 2020.1.217 and iimpi.2020a
module load GSL/2.6-iccifort-2020.1.217
export GLS_HOME=/apps/all/GSL/2.6-iccifort-2020.1.217
module load FFTW/3.3.8-intel-2020b
export FFTW_HOME=/apps/all/FFTW/3.3.8-intel-2020b
module load HDF5/1.10.7-iimpi-2020b

# module load METIS/5.1.0-intel-2020a
module load SuiteSparse/5.8.1-intel-2020b-METIS-5.1.0
# module load ParMETIS/4.0.3-intel-2020a

# module load CUDA/10.2.89
# export CUDA_FLAGS="--enable-cuda --enable-nvtx --with-cuda-prefix=$CUDA_HOME"

}

LoadOctopusKarolinaIntel() {

module purge
# MKL
module load imkl/2020.4.304-iimpi-2020b
# FFTW3
export MKL_HOME="$MKLROOT"
export FFTW_HOME="${MKL_HOME}/include/fftw/"
module load FFTW/3.3.8-intel-2020b
# LibXC
module load libxc/4.3.4-intel-2020b
export LIBXC_HOME=/apps/all/libxc/4.3.4-intel-2020b/
# NetCDFF
module load netCDF/4.7.4-intel-2020b
module load netCDF-Fortran/4.5.3-intel-2020b
# GSL
module load GSL/2.6-iccifort-2020.4.304

}

LoadOctopusNavigatorModulesFortran2021() {
 module purge

 module load iccifort/2019.5.281
 module load iimpi/2019b
 module load imkl/2019.5.281-iimpi-2019b
 export MKL_HOME="/apps/software/imkl/2019.5.281-iimpi-2019b/"
 source /apps/software/imkl/2019.5.281-iimpi-2019b/bin/compilervars.sh intel64

 module load libxc/4.3.4-iccifort-2019.5.281
 export LIBXC_HOME="/apps/software/libxc/4.3.4-iccifort-2019.5.281"

 module load GSL/2.6-iccifort-2019.5.281
 export GSL_HOME="/apps/software/GSL/2.6-iccifort-2019.5.281/"

 # export LIBXC_HOME=/net/people/prace/pr2c0043/libxc
 # export LIBXC_HOME=/net/software/local/libxc/4.2.3

 module load libyaml/0.2.2-GCCcore-8.3.0
 export YAML_HOME=/apps/software/libyaml/0.2.2-GCCcore-8.3.0/
 
 module list

# export I_MPI_FABRICS=shm:ofi
# export I_MPI_OFI_PROVIDER=verbs
}

LoadOctopusEclipseModulesGNU() {
# module load IntelOneAPI/compiler/2021.1.1
# module load IntelOneAPI/intel_ipp_intel64/2021.1.1
# module load IntelOneAPI/intel_ippcp_intel64/2021.1.1

module load GCC/8.1.0

# module load ifort/2017.7.259-GCC-6.3.0-2.27
# module load impi/2017.4.239-iccifort-2017.7.259-GCC-6.3.0-2.27
# module load plgrid/tools/impi/2018
# module load IntelOneAPI/mpi/2021.1.1
module load OpenMPI/3.1.0-GCC-8.1.0

# module load imkl/2017.4.239-iimpi-2017c 
# module load IntelOneAPI/mkl/2021.1.1
# module load IntelOneAPI/tbb/2021.1.1
module load BLAS/3.8.0-GCC-8.1.0

module load LAPACK/3.8.0-GCC-8.1.0

# module load plgrid/libs/libxc/4.2.3
# module load libxc/5.2.3-GCC-8.1.0
module load libxc/4.3.4-GCC-8.1.0
export LIBXC_HOME=/gpfs/apps/tools/modulefiles/software/libxc/4.3.4-GCC-8.1.0

# module load plgrid/libs/gsl/2.4
module load GSL/2.6-GCC-8.1.0
export GSL_HOME="/gpfs/apps/tools/modulefiles/software/GSL/2.6-GCC-8.1.0/"

# module load plgrid/libs/fftw/3.3.7
module load FFTW/3.3.10-OpenMPI-3.1.0-GCC-8.1.0
export FFTW_HOME="/gpfs/apps/tools/modulefiles/software/FFTW/3.3.10-OpenMPI-3.1.0-GCC-8.1.0/"
# module load plgrid/libs/hdf5/1.10.4
module load HDF5/1.12.0-OpenMPI-3.1.0-GCC-8.1.0
# module load plgrid/libs/netcdf/4.7.0
module load netCDF/4.9.0-OpenMPI-3.1.0-GCC-8.1.0
module list
}

LoadOctopusModulesSunrise12() {
module purge
module load GCC/12.1.0
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/APPS/centos7/centos79/software/Core/GCC/12.1.0/lib64

module load OpenMPI/4.1.3
module load BLAS/3.10.0

# Edwin's lapack: fails: missing reference to a certain function: undefined reference to 'scnrm2_'. No longer needed after update of BLAS by Edwin. 
module load LAPACK/3.10.1
# export LAPACK_HOME="/APPS/centos7/centos79/software/Compiler/GCC-12.1/LAPACK/3.10.1/liblapack.a"

# module load libxc/6.2.2
# module load libxc/5.2.3
module load libxc/4.3.4
# module load libxc/5.2.3-GCC-8.1.0
export LIBXC_HOME="/APPS/centos7/centos79/software/Compiler/GCC-12.1/libxc/4.3.4"
module load GSL/2.7
export GSL_HOME="/APPS/centos7/centos79/software/Compiler/GCC-12.1/GSL/2.7"

# Passes configure, but compilation fails. 
module load FFTW3/3.3.10
export FFTW_HOME="/APPS/centos7/centos79/software/MPI/GCC-12.1-OpenMPI-4.1/FFTW3/3.3.10"

module load HDF5/1.12.0

}

LoadOctopusModulesSunrise() {
module purge
# module load GCC/12.1.0
module load GCC/7.2.0

# module load OpenMPI/4.1.3
module load OpenMPI/3.1.6
module load BLAS/3.10.0

# Edwin's lapack: fails: missing reference to a certain function: undefined reference to 'scnrm2_'. No longer needed after update of BLAS by Edwin. 
module load LAPACK/3.10.1
# export LAPACK_HOME="/APPS/centos7/centos79/software/Compiler/GCC-12.1/LAPACK/3.10.1/liblapack.a"

# module load libxc/6.2.2
# module load libxc/5.2.3
module load libxc/4.3.4
# module load libxc/5.2.3-GCC-8.1.0
# export LIBXC_HOME="/APPS/centos7/centos79/software/Compiler/GCC-12.1/libxc/5.2.3"
# export LIBXC_HOME="/APPS/centos7/centos79/software/Compiler/GCC-12.1/libxc/4.3.4"
export LIBXC_HOME="/APPS/centos7/centos79/software/Compiler/GCC-7.2/libxc/4.3.4"
module load GSL/2.7
# export GSL_HOME="/APPS/centos7/centos79/software/Compiler/GCC-12.1/GSL/2.7"
export GSL_HOME="/APPS/centos7/centos79/software/Compiler/GCC-7.2/GSL/2.7"

# Passes configure, but compilation fails. 
module load FFTW3/3.3.10
# export FFTW_HOME="/APPS/centos7/centos79/software/MPI/GCC-12.1-OpenMPI-4.1/FFTW3/3.3.10"
export FFTW_HOME="/APPS/centos7/centos79/software/MPI/GCC-7.2-OpenMPI-3.1/FFTW3/3.3.10"
# module load HDF5/1.12.0
module load HDF5/1.10.2


}
