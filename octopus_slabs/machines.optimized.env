# Version of machines.env optimized by ChatGPT v5 on Sept. 17th 2025
# ---------- logging -----------------------------------------------------------
: "${MACHINES_ENV_VERBOSE:=1}"
_log() {
  # _log LEVEL MESSAGE...
  local lvl="$1"; shift
  # levels: INFO WARN ERROR DEBUG
  case "$lvl" in
    DEBUG) [ "$MACHINES_ENV_VERBOSE" = "1" ] || return 0 ;;
  esac
  printf "[%s] %s\n" "$lvl" "$*" >&2
}

_have() { command -v "$1" >/dev/null 2>&1; }

# Lmod wrappers with logging (no-op if 'module' absent)
_module_purge() {
  if type module >/dev/null 2>&1; then
    _log INFO "module purge"
    module purge
  else
    _log DEBUG "'module' not found; skipping purge"
  fi
}
_module_load() {
  if type module >/dev/null 2>&1; then
    _log INFO "module load $*"
    module load "$@"
  else
    _log DEBUG "'module' not found; cannot load: $*"
  fi
}

# Bootstrap conda with logging
# Usage: _conda_bootstrap [env_name]
_conda_bootstrap() {
  local env_name="${1:-}"
  local hook_candidates=(
    "/apps/software/Anaconda/2020.11/bin/conda"
    "/apps/software/Anaconda3/2019.10/bin/conda"
  )
  local sh_candidates=(
    "/apps/software/Anaconda/2020.11/etc/profile.d/conda.sh"
    "/gpfs/apps/tools/modulefiles/software/Anaconda/3-2018.12/etc/profile.d/conda.sh"
  )

  if _have conda; then
    _log INFO "Found 'conda' in PATH ($(command -v conda)); enabling shell hook"
    eval "$(conda shell.bash hook 2>/dev/null)" || _log WARN "conda shell hook failed (continuing)"
  else
    local hooked=""
    for h in "${hook_candidates[@]}"; do
      if [ -x "$h" ]; then
        _log INFO "Bootstrapping conda via hook: $h shell.bash hook"
        if eval "$("$h" shell.bash hook 2>/dev/null)"; then
          hooked="yes"; break
        else
          _log WARN "Hook failed: $h"
        fi
      fi
    done
    if [ -z "$hooked" ] && ! _have conda; then
      for s in "${sh_candidates[@]}"; do
        if [ -f "$s" ]; then
          _log INFO "Sourcing conda.sh: $s"
          . "$s"
          break
        fi
      done
    fi
    _have conda || {
      _log WARN "conda still not found; falling back to PATH+=\$PYTHONPATH"
      export PATH="${PYTHONPATH:-}:$PATH"
    }
  fi

  if _have conda; then
    _log INFO "conda: $(conda --version 2>/dev/null || echo unknown)"
  fi

  if [ -n "$env_name" ] && _have conda; then
    _log INFO "conda activate $env_name"
    conda activate "$env_name" || _log WARN "Failed to activate env '$env_name'"
  fi

  # Report final python/conda locations
  _log DEBUG "python: $(command -v python || echo 'not found')"
  _log DEBUG "conda:  $(command -v conda  || echo 'not found')"
}

# Common exports with logging
_set_common() {
  export UseScreen=""
  export AbsPath="$QuantumLaPruns"
  export OctopusSlabsSources="$QuantumLaPsources"
  export OctopusSlabsRuns="$QuantumLaPruns"
  export SubmitCommand="${1}"
  export SubmitScript="${2}"
  export QueueCommand="${3}"
  export ResultFile="octopus-td"
  export RunningMark=" R"
  export StatusColumn="\$5"
  export RunningTimeColumn="\$6"
  export LoginName="${5:-${LOGNAME}}"
  export GateWayAddress="${4}"

  _log INFO "Scheduler: submit=${SubmitCommand} script=${SubmitScript} queue=${QueueCommand}"
  _log DEBUG "Paths: Sources=${OctopusSlabsSources} Runs=${OctopusSlabsRuns}"
  [ -n "${GateWayAddress}" ] && _log DEBUG "Gateway: ${GateWayAddress}"
}

