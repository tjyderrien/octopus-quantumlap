#!/bin/bash

## TODO: change this file to dnsdomainname.
## Command could be hostnamectl | grep 'Static hostname' | awk '{ print $3 }'

#List of computers to run the code
export AsusThibs="thibault-UX303LB"
export EOS="eos"
export Hydra="hydra"
export Draco="draco" #draco04.mpcdf.mpg.de
export DracoVisual="drav"
export SalomonLogin="login?.salomon"
export PrometheusLogin="prometheus"
export PrometheusRuns="p???"
export LenovoTibo="MS-83"
export BIATRI="biatri-srv.hilase.cz"
export BarboraLogin="login?.barbora.it4i.cz"
export BarboraRun="barbora.it4i.cz"
export IBM="51c21493cb4a"
export kastanienallee="kastanienallee"
export navigator="barinel"
export navigator_login="login00?"

UseScreen=""
unset $UseScreen #empty means false (dont use screen). Something means true (use screen).

CheckComputerName () {
# Checks on which computer we are
  export ComputerName=$( uname -a | awk '{ print $2 }' )
#  echo "[machines.env]: Computer name: ${ComputerName}." Warning: this line is disabling SCP transfers when invoked in bashrc. 
}

LoadEnvLibraries() {
	echo "${ComputerName}"
  case "${ComputerName}" in
    ${EOS}*)
      # Modules for EOS
      module purge
      module load remotevis
      module load ffmpeg/2.7
      module load python27/python/2.7
      module load python27/scipy/2015.01
      module load visit/2.9
      export AbsPath=/scratch/tjyderri/octopus-slabs
      export SubmitCommand=qsub
      export SubmitScript=submit_mpi.sge
      export QueueCommand=qstat
      export ResultFile="run.txt"
      export ServerAddress=eos01.bc.rzg.mpg.de
      export RunningMark=" r"
      export StatusColumn="\$6" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
      export LoginName="tjyderri"
      export GateWayAddress="gate.rzg.mpg.de"
      ;;


    ${AsusThibs})
      export AbsPath=/home/thibault/Documents/octopus
      export SubmitCommand="#"
      export SubmitScript="#"
      export QueueCommand="#"

      ;;
     
    ${Hydra}*)
      export AbsPath=/ptmp/tjyderri/octopus-slabs
      export SubmitCommand=llsubmit
      export SubmitScript=submit.ll
      export QueueCommand=llq
       ;;

    ${Draco}*)
      module purge
      module load ffmpeg
      module load anaconda/2/2019.03
      module load visit
      module load gnuplot
      echo "[machines.env]: branching with Draco..."
      export AbsPath=$QuantumLaPruns #TODO: kill this variable for sources and runs! 
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=sbatch
      export SubmitScript=submit.sbatch
      export QueueCommand=squeue
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
      export LoginName="tjyderri"
      export GateWayAddress="gate.rzg.mpg.de"
      ;;

    ${DracoVisual}*)
      module purge
      module load ffmpeg/3.4
      module load python2/anaconda/2/5.1
      module load visit/2.13
      module load imagemagick/7.0
      export I_MPI_DAPL_TRANSLATION_CACHE=0 #some MPI problems when executing on many nodes
      echo "[machines.env]: branching with Draco visual..."
      export AbsPath=$QuantumLaPruns
      export SubmitCommand=sbatch
      export SubmitScript=submit.sbatch
      export QueueCommand=squeue
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="vglrun visit"
      export LoginName="tjyderri"
      export GateWayAddress="gate.rzg.mpg.de"
      ;;
    ${SalomonLogin}*)
      module purge
      module load Anaconda2/5.3.1
      module load gnuplot/5.2.7-GCC-6.3.0-2.27
      module load VisIt/2.10.0
      module load FFmpeg/4.1
      # Warning: module load git induces problems on ... Git.  
      export UseScreen=""
      export AbsPath=$QuantumLaPruns
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=qsub
      export SubmitScript=submit_salomon.pbs
      export QueueCommand=qstat
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
      export LoginName="tjyderrien"
      export GateWayAddress="salomon.it4i.cz"
    ;;

    ${BarboraLogin}*)
      echo "[machines.env]: branching with barbora login nodes..."
      module purge
      # module load Anaconda3/2019.10
      module load gnuplot/5.2.8
#      module load VisIt/2.10.0
      module load FFmpeg/4.2.2
      # Warning: module load git induces problems on ... Git.  
      export UseScreen=""
      export AbsPath=$QuantumLaPruns
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=qsub
      export SubmitScript=submit_barbora.pbs
      export QueueCommand=qstat
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
#      export LoginName="tjyderrien"
      export LoginName=${LOGNAME}
      export GateWayAddress="login?.barbora.it4i.cz"
    ;;

   ${navigator}*)
      echo "[machines.env]: branching with Navigator production nodes..."
      module purge
      export UseScreen=""
      export AbsPath=$QuantumLaPruns
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=sbatch
      export SubmitScript=submit_navigator.sbatch
      export QueueCommand=squeue
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
#      export LoginName="tjyderrien"
      export LoginName=${LOGNAME}
      export GateWayAddress="navigator.lca.uc.pt"
    ;;



   ${navigator_login}*)
      echo "[machines.env]: branching with Navigator login nodes..."
      module purge
      module load Anaconda/2020.11
__conda_setup="$('/apps/software/Anaconda/2020.11/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/apps/software/Anaconda/2020.11/etc/profile.d/conda.sh" ]; then
        . "/apps/software/Anaconda/2020.11/etc/profile.d/conda.sh"
    else
        export PATH="/apps/software/Anaconda/2020.11/bin:$PATH"
    fi
fi
unset __conda_setup
      conda activate anaconda3
      module load gnuplot/5.2.8-GCCcore-8.3.0
#      module load VisIt/2.10.0
#      module load FFmpeg/4.2.2-GCCcore-9.3.0 
      export UseScreen=""
      export AbsPath=$QuantumLaPruns
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=sbatch
      export SubmitScript=submit_navigator.sbatch
      export QueueCommand=squeue
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
#      export LoginName="tjyderrien"
      export LoginName=${LOGNAME}
      export GateWayAddress="navigator.lca.uc.pt"
    ;;




    *${PrometheusLogin}*)
      module purge
      module load plgrid/tools/git/2.19.0
#      module load plgrid/tools/intel/18.0.0
#      module load plgrid/tools/impi/2018
#      module load plgrid/libs/mkl/2018.0.0
#      module load plgrid/libs/libxc/4.2.3
#      module load plgrid/libs/gsl/2.4
#      module load plgrid/libs/fftw/3.3.7
#      module load plgrid/libs/hdf5/1.10.5
#      module load plgrid/libs/netcdf/4.7.0 
      module load plgrid/tools/gnuplot/5.2.4
      module load plgrid/libs/python-numpy/1.14.2-python-2.7
      module load plgrid/libs/python-scipy/1.0.1-python-2.7
      echo "[machines.env]: branching with Prometheus login..."
      export AbsPath=$QuantumLaPruns
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=sbatch
      export SubmitScript=submit_prometheus.sbatch
      export QueueCommand=squeue
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="vglrun visit"
      export LoginName="pr2c0043"
      export GateWayAddress="prace.prometheus.cyfronet.pl"
    ;;

    ${PrometheusRuns}*)
      module purge
      module load plgrid/tools/git/2.19.0
      module load plgrid/tools/intel/18.0.0
      module load plgrid/tools/impi/2018
      module load plgrid/libs/mkl/2018.0.0
      module load plgrid/libs/libxc/4.2.3
      module load plgrid/libs/gsl/2.4
      module load plgrid/libs/fftw/3.3.7
      module load plgrid/libs/hdf5/1.10.5
      module load plgrid/libs/netcdf/4.7.0
      module load plgrid/tools/gnuplot/5.2.4
      module load plgrid/libs/python-numpy/1.14.2-python-2.7
      module load plgrid/libs/python-scipy/1.0.1-python-2.7
      cho "[machines.env]: branching with Prometheus running nodes..."
      export AbsPath=${QuantumLaPruns}
      export OctopusSlabsSources=${QuantumLaPsources}
      export OctopusSlabsRuns=${QuantumLaPruns}
      export SubmitCommand=sbatch
      export SubmitScript=submit_prometheus.sbatch
      export QueueCommand=squeue
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="vglrun visit"
      export LoginName="pr2c0043"
      export GateWayAddress="prace.prometheus.cyfronet.pl"
    ;;

      ${kastanienallee})
      export UseScreen=""
      export AbsPath=$QuantumLaPruns
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=""
      export QueueCommand=qstat
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS 
      ;;


      ${BIATRI})
      export UseScreen=""
      export AbsPath=$QuantumLaPruns
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=""
      export QueueCommand=qstat
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS 
      ;;
   
      ${LenovoTibo}*)
      export UseScreen=""
      export AbsPath=${QuantumLaPruns}
      export OctopusSlabsSources=${QuantumLaPsources}
      export OctopusSlabsRuns=${QuantumLaPruns}
      export SubmitCommand=""
      export SubmitScript=submit_salomon.pbs
      export QueueCommand=qstat
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
      export LoginName="hilase"
      export GateWayAddress="" #salomon.it4i.cz"
    ;;

      ${IBM})
      echo "[machines.env]: branching with IBM node..."
      module purge
#      module load Anaconda3/2019.10
#      module load gnuplot/5.2.8
#      module load VisIt/2.10.0
#      module load FFmpeg/4.2.2
      # Warning: module load git induces problems on ... Git.  
      export UseScreen=""
      export AbsPath=$QuantumLaPruns
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=qsub
      export SubmitScript=submit_salomon.pbs
      export QueueCommand=qstat
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
      export LoginName="tjyderrien"
      export GateWayAddress=""
    ;;

    *)
      echo "[machines.env] Computer is not recognized !"
      echo "Add your computer name in the script machines.env."
      echo "As we need this case for Draco batch mode, we add the same lines as Draco below."

      export AbsPath=$QuantumLaPruns #TODO: kill this variable for sources and runs! 
      export OctopusSlabsSources=$QuantumLaPsources
      export OctopusSlabsRuns=$QuantumLaPruns
      export SubmitCommand=sbatch
      export SubmitScript=submit.sbatch
      export QueueCommand=squeue
      export ResultFile=octopus-td
      export RunningMark=" R"
      export StatusColumn="\$5" #status column number
      export RunningTimeColumn="\$6" #TODO: more complicated for EOS
      export RunVisit="visit"
      export LoginName=${LOGNAME}
#      export GateWayAddress="gate.rzg.mpg.de"
      ;;
  esac
#  export basePath=${AbsPath}/02-Slab2D
}

