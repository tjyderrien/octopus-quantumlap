# used with octopus svn revision 15009
# used with 1188/2376 cpu cores (2376 cpu cores = 18*6 kpoints * 22 states) 

CalculationMode = td
ExperimentalFeatures=yes
FromScratch = yes

ParKpoints = auto
ParStates  = auto

PeriodicDimensions = 2

%RestartOptions
  restart_gs | "../GS/restart/"
%

a = 7.984092302 # 4.225 Ang


nslab= 12 # number of slab layers
nvac = 53  # number of vaccum layers ~ 150 au
n = nslab+nvac

BoxShape = parallelepiped
Spacing=0.3


%Lsize
 a/2 | a*sqrt(2)/2 | n*a/sqrt(2)/2
%

%ReducedCoordinates
 'Na' |  0.  |    0. |   0.  -5.5/n
 'Na' |  1/2 |   1/2 |   0.  -5.5/n
 'Na' |  0.  |   1/2 |   1/n -5.5/n
 'Na' |  1/2 |   0.  |   1/n -5.5/n
 'Na' |  0.  |    0. |   2/n -5.5/n
 'Na' |  1/2 |   1/2 |   2/n -5.5/n
 'Na' |  0.  |   1/2 |   3/n -5.5/n
 'Na' |  1/2 |   0.  |   3/n -5.5/n
 'Na' |  0.  |    0. |   4/n -5.5/n
 'Na' |  1/2 |   1/2 |   4/n -5.5/n
 'Na' |  0.  |   1/2 |   5/n -5.5/n
 'Na' |  1/2 |   0.  |   5/n -5.5/n
 'Na' |  0.  |    0. |   6/n -5.5/n
 'Na' |  1/2 |   1/2 |   6/n -5.5/n
 'Na' |  0.  |   1/2 |   7/n -5.5/n
 'Na' |  1/2 |   0.  |   7/n -5.5/n
 'Na' |  0.  |    0. |   8/n -5.5/n
 'Na' |  1/2 |   1/2 |   8/n -5.5/n
 'Na' |  0.  |   1/2 |   9/n -5.5/n
 'Na' |  1/2 |   0.  |   9/n -5.5/n
 'Na' |  0.  |    0. |   10/n -5.5/n
 'Na' |  1/2 |   1/2 |   10/n -5.5/n
 'Na' |  0.  |   1/2 |   11/n -5.5/n
 'Na' |  1/2 |   0.  |   11/n -5.5/n
%

%KPointsGrid
  18   | 6   | 1
%


ExtraStates = 10
smearing = 0.0002
SmearingFunction=fermi_dirac

MaximumIter=1000
Mixing = 0.05

#############
# LASER
#############

omega = 18/27.211
I  = 1.0E12
EE = sqrt(I/3.51e+16)
amplitude = EE * 137/omega

tc = 2*pi/omega
nc = 120
nu = 3

th = pi/4
px = cos(th)
pz = sin(th)

%TDExternalFields
    vector_potential | px | 0 | pz | omega | "envelope_function"
%

%TDFunctions
"envelope_function" | tdf_trapezoidal | amplitude | nc*tc | (nc+2*nu)*tc/2 |
nu*tc
%


TDTimeStep = 0.05
TDPropagationTime = (nc+2*nu)*tc

############
# PES
############
dLz = a/sqrt(2)/2
Lmin = 11*dLz + 20
LL = n*a/sqrt(2)/2

PhotoElectronSpectrum = pes_mask
%PESMaskSize
Lmin | LL | "abs(z)"
%
PESMaskMode = mask_mode
PESMaskPlaneWaveProjection = nfft_map
EM = omega + 5./27.211 # the maximum energy we want in the spectrum = 5eV above
omega
PESMask2PEnlargeFactor = pi/Spacing/sqrt(2*EM)

TDOutput = gauge_field + energy + laser

OutputInterval = 250
RestartWriteInterval = 250


